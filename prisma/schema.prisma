// ============================================================================
//  🔴 LEE ESTO ANTES DE TOCAR NADA DE ESTE FICHERO
// ============================================================================
//
//  Este esquema YA NO DESCRIBE la base de datos de Quéjate. Describe **solo lo
//  que el Auth.js de este panel necesita leer y escribir**. Es un recorte
//  deliberado, no un esquema incompleto por descuido.
//
//  ## Por qué se recortó (Tarea 15, 28/08/2026)
//
//  Hasta el repunte había **tres** esquemas de Prisma sobre la MISMA base de
//  producción —`quejate-app`, este panel y `quejate-backend`— y cada aplicación
//  se creía responsable del esquema. Ese es el incidente A-01, y el peligro no
//  era teórico: las copias iban 4 migraciones por detrás, y entre las que les
//  faltaban estaba `20260731193901_add_tokens_valid_after`, la columna que
//  sostiene la revocación de sesiones (ADR-0004). Ejecutar `prisma migrate dev`
//  desde aquí habría hecho que Prisma **propusiera borrarla**, y con ella la
//  capacidad de invalidar una sesión robada.
//
//  Desde la Tarea 15 este panel no consulta la base de datos para nada que no
//  sea la sesión: todo lo demás va por el backend unificado
//  (`lib/api/backend.ts`). Un esquema completo aquí ya no describía nada real;
//  solo era un arma cargada.
//
//  ## Las reglas
//
//  1. **`quejate-backend` es el ÚNICO dueño del esquema.** Toda migración se
//     escribe allí. Este repositorio no migra.
//  2. **NO existe `prisma/migrations/` aquí, y no se vuelve a crear.** Sin
//     historial, `migrate deploy` no tiene nada que aplicar y `migrate dev` no
//     puede proponer un borrado en silencio.
//  3. **Los únicos comandos válidos son `prisma generate` y `prisma db pull`.**
//     `migrate dev`, `migrate deploy`, `db push` y `migrate reset` están
//     prohibidos en este repositorio, sin excepción.
//  4. **Si necesitas una columna nueva**, se añade en `quejate-backend` con su
//     migración, y aquí solo se declara si el Auth.js de este panel la usa.
//
//  ## Por qué estos cuatro modelos y no otros
//
//  Se midió, no se supuso. Es todo lo que queda leyendo Prisma en el panel:
//
//  - `User`    — `auth.config.ts` (comparar la contraseña), el callback `jwt`
//                (nombre, correo, rol, imagen), el callback `signIn` (rol y
//                cuenta activa) y `actions/register|new-password|
//                new-verification`.
//  - `Account` — `data/account.ts`, para saber si la cuenta entró por Google
//                (`isOAuth`), y el adaptador al enlazar una cuenta OAuth.
//  - `VerificationToken`  — verificación de correo (`lib/tokens.ts`).
//  - `PasswordResetToken` — restablecimiento de contraseña (`lib/tokens.ts`).
//
//  **`Session` NO hace falta**: la estrategia es `jwt`, así que el adaptador
//  nunca crea ni lee sesiones en base de datos. De hecho tampoco estaba antes
//  del recorte, y `PrismaAdapter` compilaba igual.
//
//  Los dos modelos de token están aquí porque el panel todavía tiene **su
//  propio registro y su propio restablecimiento de contraseña**. Ese es el
//  siguiente paso pendiente y no entra en la Tarea 15: el estado final deseado
//  es quitar el adaptador y que el panel delegue la sesión entera en el
//  backend, que ya resuelve Google sin adaptador en `POST /auth/mobile/google`.
//  Cuando eso ocurra, este fichero se queda sin razón de existir.
//
//  ## Los campos
//
//  `User` declara solo las columnas que el panel usa. La tabla real tiene
//  muchas más (`entityId`, `departmentId`, `tokensValidAfter`, `pushToken`…):
//  no declararlas aquí no las borra ni las oculta — Prisma simplemente no las
//  selecciona. Los `@default` se conservan **idénticos** a los del backend para
//  que un `user.create` desde el registro del panel produzca la misma fila.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cuenta de la plataforma. Recorte de lectura: la tabla real vive en
/// `quejate-backend/prisma/schema.prisma`.
model User {
  id            String    @id @default(uuid())
  name          String?
  image         String?
  password      String?
  email         String?   @unique
  phone         String?
  role          UserRole  @default(CLIENT)
  emailVerified DateTime?
  /// Desactivar una cuenta le corta el acceso: lo comprueba el callback
  /// `signIn` y, en cada petición al backend, `EntityScopeGuard`.
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
}

/// Cuenta de un proveedor OAuth (hoy solo Google). La necesita el adaptador.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

/// Token de verificación de correo del registro propio del panel.
model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("verification_tokens")
}

/// Token de restablecimiento de contraseña del panel.
model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

enum UserRole {
  ADMIN
  EMPLOYEE
  CLIENT
  SUPER_ADMIN
  LAWYER
}
